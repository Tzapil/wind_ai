{
  "name": "poputnogo-vetra",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "pnpm --filter @poputnogo-vetra/client dev",
    "build": "pnpm data:build && pnpm --filter @poputnogo-vetra/core build && pnpm --filter @poputnogo-vetra/client build",
    "preview": "pnpm --filter @poputnogo-vetra/client preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "pnpm --filter @poputnogo-vetra/core typecheck && pnpm --filter @poputnogo-vetra/client typecheck",
    "format": "prettier --write .",
    "data:build": "node tools/databuild/index.mjs",
    "map:build": "node tools/mapgen/index.mjs",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "eslint": "10.16.0",
    "eslint-plugin-i18next": "^6.1.5",
    "happy-dom": "21.0.4",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.4.0",
    "vitest": "5.1.2"
  }
}
